# ─── Server ──────────────────────────────────────────
PORT=8080
HOST=0.0.0.0

# ─── SSL/TLS (auto-detected from ./certs/ if present) ─
# Or specify custom paths:
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
#
# Quick setup:
#   Development:  npm run setup:ssl
#   Production:   npm run setup:ssl:prod yourdomain.com

# ─── JWT Authentication ──────────────────────────────
# Set to 'true' to require JWT token on WebSocket connect
AUTH_ENABLED=false

# IMPORTANT: Set a strong secret for production (at least 64 chars)
# If not set, a random secret is auto-generated (tokens reset on restart)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=24h

# ─── Scaling ─────────────────────────────────────────
MAX_TOTAL_CONNECTIONS=50000
CLUSTER_WORKERS=0

# Redis for multi-server scaling (optional)
# First install: npm install redis
# REDIS_URL=redis://localhost:6379

# ─── Rate Limiting ───────────────────────────────────
MAX_CONNECTIONS_PER_IP=5
MESSAGE_RATE_LIMIT=20
MESSAGE_RATE_WINDOW_MS=1000

# ─── WebSocket ───────────────────────────────────────
HEARTBEAT_INTERVAL_MS=30000

# ─── STUN/TURN Servers ───────────────────────────────
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN server (set up with: npm run setup:turn)
# TURN_SERVER=turn:your-server.com:3478
# TURN_USERNAME=videocall
# TURN_CREDENTIAL=your-password

# ─── Security ────────────────────────────────────────
ALLOWED_ORIGINS=

# ─── Logging ─────────────────────────────────────────
LOG_LEVEL=info
