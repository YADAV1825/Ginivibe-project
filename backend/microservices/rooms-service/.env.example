# Same shared root .env pattern the other microservices use
# (see backend/microservices/.env.example) — DATABASE_URL and JWT_SECRET
# should already be defined there and are picked up automatically via
# src/config/database.ts's `dotenv.config({ path: '../../../.env' })`.
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# JWT_SECRET="use-the-same-secret-as-the-auth-service"

# New for this service — add these to the shared root .env too.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud

# Optional — defaults to 3007 (next free port after monolithic's 3001,
# events-service's 3002, non-live-matching's 3003, Gini_AI's 3004,
# enterprise's 3005, and astrology's 3006)
PORT=3007